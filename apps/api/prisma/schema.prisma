generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  checkIns     CheckIn[]
  insights     Insight[]

  @@map("users")
}

model CheckIn {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurredOn    DateTime @db.Date @map("occurred_on")
  urgeIntensity Int      @map("urge_intensity")
  actedOnUrge   Boolean  @map("acted_on_urge")
  trigger       String?
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  insights      Insight[]

  @@unique([userId, occurredOn])
  @@map("check_ins")
}

model Insight {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceCheckInId String   @map("source_check_in_id")
  sourceCheckIn   CheckIn  @relation(fields: [sourceCheckInId], references: [id], onDelete: Cascade)
  promptVersion   String   @map("prompt_version")
  model           String
  inputCheckInIds String[] @map("input_check_in_ids")
  output          Json
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  latencyMs       Int      @map("latency_ms")
  status          String
  error           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("insights")
}
