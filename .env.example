NODE_ENV=development
PORT=3000

# This project's Docker Postgres is published on 5434 so it does not
# collide with a local Postgres on 5432 or another container on 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/recovery_coach
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/recovery_coach_test

# Random string used to sign login cookies. Change this before deploy.
JWT_SECRET=change-me-in-local-env

# React app origin. Required so the API can set CORS + allow the auth cookie.
WEB_ORIGIN=http://localhost:5173

# LLM is not used yet. Add keys locally; never commit them.
# V1 local default: Groq. Switch to OpenAI nano when real users exist.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_API_KEY=
